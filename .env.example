# Copy to .env. Docker Compose 2.24.4+ is required for !override.
# A checkout uses compose.override.yml and builds :local automatically.
# To use a published image: docker compose -f compose.yml up -d
BABYLON_IMAGE_TAG=latest
# Set to the address players can reach; no scheme or port.
BABYLON_PUBLIC_HOST=127.0.0.1
BABYLON_SERVER_NAME=Babylon13
# BYOND account names, comma-separated. These are lobby admins, not game admins.
BABYLON_ADMINS=
# List the lobby on the BYOND hub (true/false). Child worlds are never listed;
# the lobby's hub status shows the total player count across all worlds.
BABYLON_HUB_LISTED=false
# Hub entry and its password; defaults to upstream's shared Space Station 13
# entry, whose password is public in code/world.dm.
BABYLON_HUB=Exadv1.spacestation13
BABYLON_HUB_PASSWORD=kMZy3U5jJHSiBQjr
# Hub status line (HTML); empty uses the default. Placeholders: {name} {players}
# {lobby_players} {world_players} {running_worlds} {running_worlds_label}
# {max_running_worlds} {address}. See modular_babylon/CLUSTER.md.
BABYLON_HUB_STATUS=
# Discord bot and account linking (all optional; see modular_babylon/CLUSTER.md).
# Bot token; empty keeps the bot off.
BABYLON_DISCORD_TOKEN=
# The Discord server (guild) ID.
BABYLON_DISCORD_GUILD_ID=
# Comma list of link, roles, voice, logs, status, gamelog, tickets, ahelp (default link,roles).
BABYLON_DISCORD_FEATURES=
# https:// invite: in-game Discord button, lobby, link instructions.
BABYLON_DISCORD_INVITE=
# https:// join page shown in the status message.
BABYLON_JOIN_URL=
# https:// rules link for the in-game Rules button.
BABYLON_RULES_URL=
# true: a linked Discord account is needed to create worlds.
BABYLON_REQUIRE_DISCORD_TO_CREATE=
# true: a linked Discord account is needed to join or start worlds.
BABYLON_REQUIRE_DISCORD_TO_JOIN=
# Role ID given to linked accounts (optional).
BABYLON_DISCORD_LINKED_ROLE=
# Role IDs the role buttons may toggle.
BABYLON_DISCORD_SELF_ROLES=
# Exclusive name colour role IDs for the colour buttons.
BABYLON_DISCORD_COLOR_ROLES=
# Role IDs with access to every ticket.
BABYLON_DISCORD_STAFF_ROLES=
# Category ID for ticket channels.
BABYLON_DISCORD_TICKET_CATEGORY=
# Read-only channel with the Open a ticket button.
BABYLON_DISCORD_TICKET_PANEL_CHANNEL=
# Staff channel for ticket transcripts.
BABYLON_DISCORD_TICKET_LOG_CHANNEL=
# Channel of the live status message.
BABYLON_DISCORD_STATUS_CHANNEL=
# Voice channel that creates a room when joined.
BABYLON_DISCORD_VOICE_LOBBY_CHANNEL=
# Name of created rooms; {name} is the member's name.
BABYLON_DISCORD_VOICE_ROOM_NAME=
# Kicks, bans, timeouts.
BABYLON_DISCORD_MOD_LOG_CHANNEL=
# Joins, leaves, role and nickname changes, links.
BABYLON_DISCORD_MEMBER_LOG_CHANNEL=
# Edited and deleted messages.
BABYLON_DISCORD_MESSAGE_LOG_CHANNEL=
# Voice joins, leaves and moves.
BABYLON_DISCORD_VOICE_LOG_CHANNEL=
# Supervisor events (gamelog feature).
BABYLON_DISCORD_GAME_LOG_CHANNEL=
# ahelp: in-game adminhelps from every world, with a Reply button for staff
BABYLON_DISCORD_AHELP_CHANNEL=
# Roles counted for "Currently N admins are online" when a player ahelps (default:
# the staff roles). Needs the bot's Presence Intent; without it the count is left out.
BABYLON_DISCORD_AHELP_ROLES=
# Bot start, stop and errors.
BABYLON_DISCORD_BOT_LOG_CHANNEL=
BABYLON_LOBBY_PORT=1361
# Internal only: never published by Compose.
BABYLON_API_PORT=1360
BABYLON_WORLD_PORT_FIRST=1400
BABYLON_WORLD_PORT_LAST=1420
BABYLON_MAX_RUNNING_WORLDS=4
BABYLON_MAX_PLAYERS_PER_WORLD=4
BABYLON_MAX_WORLDS_PER_PLAYER=3
BABYLON_MAX_RUNNING_WORLDS_PER_PLAYER=1
BABYLON_KEPT_SAVE_POINTS_PER_WORLD=4
# 0 disables automatic unused-world deletion.
BABYLON_DELETE_UNUSED_WORLDS_AFTER_DAYS=60
BABYLON_EMPTY_GRACE_SECONDS=120
# World inactivity timeout, including ghosts/admins; 0 disables AFK kicks.
BABYLON_AFK_TIMEOUT_SECONDS=900
BABYLON_STARTUP_TIMEOUT_SECONDS=300
BABYLON_TICKET_LIFETIME_SECONDS=60
BABYLON_SHUTDOWN_TIMEOUT_SECONDS=180
# Countdown in every world's chat (and the lobby) before a restart; 0 skips it. Players are then
# sent to the lobby first, so their game reconnects to it on its own once the server is back.
BABYLON_RESTART_WARNING_SECONDS=30
# Must cover startup + final save/shutdown; Docker forcibly kills after this.
BABYLON_STOP_GRACE_PERIOD=10m

# Optional server-side music: a folder of tracks by mood (vault/, space/, engine/, derelict/, station/).
# Compose mounts the babylon-music volume here; see "Server music" in CLUSTER.md.
BABYLON_MUSIC_DIRECTORY=/music
# Tiles around a power generator that play engine/ music (0 turns it off).
BABYLON_MUSIC_ENGINE_RADIUS=10
# Seconds a player stays in a new mood before its music takes over.
BABYLON_MUSIC_DEBOUNCE_SECONDS=20
